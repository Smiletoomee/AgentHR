# 1. Obraz bazowy
FROM node:26.9.0-trixie AS base

# 2. Etap instalacji zależności ,deps
FROM base AS deps
WORKDIR /nextjs-app
COPY package.json package-lock.json* ./
RUN npm ci --force

# 3. Etap budowania ,builder
FROM base AS builder
WORKDIR /nextjs-app
COPY --from=deps /nextjs-app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_WS_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
RUN npm run build

# 4. Etap produkcyjny ,runner
FROM base AS runner
WORKDIR /nextjs-app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3030
ENV HOSTNAME="0.0.0.0"

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Kopiowanie struktury standalone ,zawiera odchudzone node_modules i serwer
COPY --from=builder --chown=nextjs:nodejs /nextjs-app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /nextjs-app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /nextjs-app/public ./public

# Kopiujemy pliki niezbędne do wykonania migracji przez skrypt JS ,nie przez drizzle-kit
COPY --from=builder --chown=nextjs:nodejs /nextjs-app/drizzle ./drizzle
COPY --from=builder --chown=nextjs:nodejs /nextjs-app/drizzle.config.ts ./drizzle.config.ts

USER nextjs
EXPOSE 3030

# Jeśli chcesz uruchamiać migracje automatycznie przed startem, zmień CMD na skrypt uruchomieniowy
CMD ["node", "server.js"]
